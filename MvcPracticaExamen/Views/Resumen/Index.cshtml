@using MvcPracticaExamen.Models
@model ModelPlantillaResumen

@{
    ViewData["Title"] = "Resumen Plantilla";
    string funcionActual = ViewData["Funcion"] as string;
    var funciones = ViewBag.Funciones as List<string>;
}

<div class="container mt-4">
    <h2 class="text-primary">Gestión de Plantilla</h2>
    <hr />

    <div class="card p-3 mb-4 bg-light">
        <form method="get" asp-controller="Resumen" asp-action="Index" class="row align-items-end">
            <div class="col-md-4">
                <label class="form-label">Filtrar por Función:</label>
                <select name="funcion" class="form-select">
                    <option value="">-- Todas las funciones --</option>
                    @if (funciones != null)
                    {
                        foreach (string f in funciones)
                        {
                            if (funcionActual == f)
                            {
                                <option value="@f" selected>@f</option>
                            }
                            else
                            {
                                <option value="@f">@f</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">🔍 Buscar</button>
            </div>
            <div class="col-md-4 text-end">
                <a asp-controller="Resumen" asp-action="Formulario" class="btn btn-success">➕ Nueva Persona</a>
            </div>
        </form>
    </div>

  
    @if (Model != null && Model.Plantilla != null && Model.Plantilla.Count > 0)
    {
        <div class="row mb-3 text-center">
            <div class="col-md-4">
                <div class="alert alert-success">
                    <h6>Máximo Salario</h6>
                    <h4>@Model.MaximoSalario.ToString("C")</h4>
                </div>
            </div>
            <div class="col-md-4">
                <div class="alert alert-warning">
                    <h6>Media Salarial</h6>
                    <h4>@Model.MediaSalarial.ToString("C")</h4>
                </div>
            </div>
            <div class="col-md-4">
                <div class="alert alert-info">
                    <h6>Suma Total</h6>
                    <h4>@Model.SumaSalarial.ToString("C")</h4>
                </div>
            </div>
        </div>

        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Apellido</th>
                    <th>Función</th>
                    <th>Salario</th>
                    <th>Turno</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Plantilla)
                {
                    <tr>
                        <td>@item.Apellido</td>
                        <td>@item.Funcion</td>
                        <td>@item.Salario.ToString("C")</td>
                        <td>@item.T</td>
                        <td class="text-center">
                            <a asp-action="Formulario"
                               asp-route-id="@item.EmpleadoNo"
                               class="btn btn-warning btn-sm">
                                ✏️ Editar
                            </a>
                      
                            <a asp-controller="Resumen"
                               asp-action="Delete"
                               asp-route-id="@item.EmpleadoNo"
                               asp-route-funcionActual="@funcionActual"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('¿Seguro?');">
                                🗑️ Borrar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (!string.IsNullOrEmpty(funcionActual))
    {
        <div class="alert alert-danger">No se encontraron empleados con la función: <strong>@funcionActual</strong></div>
    }
</div>