<style>
    /* Estilos personalizados para sobriedad máxima */
    .card-formal {
        border: 1px solid #dee2e6;
        border-radius: 0;
    }

    .header-dark-gray {
        background-color: #212529;
        color: #ffffff;
        border-radius: 0;
    }

    .text-formal-dark {
        color: #343a40;
    }

    .text-formal-muted {
        color: #6c757d;
    }

    .img-gray-border {
        border: 3px solid #e9ecef !important;
        filter: grayscale(20%);
    }

    .badge-formal {
        background-color: #495057;
        color: white;
        border-radius: 2px;
        font-weight: 400;
        letter-spacing: 0.5px;
    }

    .btn-formal {
        border-radius: 0;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }

    hr.formal-hr {
        border-top: 2px solid #343a40;
        opacity: 1;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card card-formal shadow-sm">
                <div class="card-header header-dark-gray py-3">
                    <h5 class="card-title mb-0 text-uppercase fw-light">
                        <i class="bi bi-person-vcard me-2"></i> Expediente Académico
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-4 text-center border-end">
                            @if (!string.IsNullOrEmpty(Model.IMAGEN))
                            {
                                <img src="@Model.IMAGEN"
                                     class="img-fluid img-gray-border shadow-sm mb-3"
                                     style="width: 160px; height: 160px; object-fit: cover;"
                                     alt="Perfil @Model.NombreUsuario" />
                            }
                            else
                            {
                                <img src="https://via.placeholder.com/150?text=SIN+FOTO" class="img-fluid img-gray-border" alt="Sin imagen" />
                            }
                            <p class="small text-formal-muted">ID ALUMNO: @Model.EMAIL.Split('@')[0]</p>
                        </div>

                        <div class="col-md-8 ps-md-4">
                            <h2 class="text-formal-dark fw-bold mb-1">@Model.NombreUsuario @Model.APELLIDOS</h2>
                            <p class="text-formal-muted mb-3"><i class="bi bi-envelope-at me-1"></i> @Model.EMAIL</p>

                            <hr class="formal-hr w-25" />

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="text-uppercase small fw-bold text-muted d-block">Curso</label>
                                    <span class="text-formal-dark">@Model.NombreCurso</span>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-uppercase small fw-bold text-muted d-block">Inscripción</label>
                                    <span class="text-formal-dark">@Model.fecha_inscripcion.ToShortDateString()</span>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-uppercase small fw-bold text-muted d-block">Periodo Lectivo</label>
                                    <span class="text-formal-dark">
                                        @Model.FECHAINICIO?.ToShortDateString() — @Model.FECHAFIN?.ToShortDateString()
                                    </span>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-uppercase small fw-bold text-muted d-block">Estatus Capitanía</label>
                                    @if (Model.quiere_ser_capitan)
                                    {
                                        <span class="badge badge-formal">
                                            <i class="bi bi-shield-check"></i> SOLICITANTE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-formal-muted small italic">No solicitada</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-top-0 p-3">
                    <a asp-controller="Alumnos" asp-action="Index" class="btn btn-outline-dark btn-formal">
                        <i class="bi bi-chevron-left"></i> Retornar al registro
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>